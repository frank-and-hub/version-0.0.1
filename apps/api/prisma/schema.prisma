generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  user_uuid              String             @id @default(uuid()) @map("user_uuid")
  email                  String             @unique
  password_hash          String             @map("password_hash")
  first_name             String             @map("first_name")
  last_name              String             @map("last_name")
  phone_number           String?            @map("phone_number")
  address                String?            @map("address")
  profile_picture_url    String?            @map("profile_picture_url")
  role                   Role               @default(USER)
  role_uuid              String?            @map("role_uuid")
  custom_role            RoleDefinition?    @relation(fields: [role_uuid], references: [role_uuid], onDelete: SetNull)
  status                 UserStatus         @default(ACTIVE)
  last_login_at          DateTime?          @map("last_login_at")
  failed_login_attempts  Int                @default(0) @map("failed_login_attempts")
  locked_until           DateTime?          @map("locked_until")
  refresh_tokens         RefreshToken[]
  activity_logs          UserActivityLog[]  @relation("TargetUser")
  actor_activity_logs    UserActivityLog[]  @relation("ActorUser")
  provider_configurations UserProviderConfiguration[]
  email_templates        EmailTemplate[]
  email_messages         EmailMessage[]
  webhook_endpoints      ProviderWebhookEndpoint[]
  webhook_events         ProviderWebhookEvent[]
  message_events         MessageEvent[]
  whatsapp_conversations WhatsAppConversation[]
  whatsapp_messages      WhatsAppMessage[]
  whatsapp_templates     WhatsAppTemplate[]
  sms_conversations      SmsConversation[]
  sms_messages           SmsMessage[]
  sms_templates          SmsTemplate[]
  sms_opt_outs           SmsOptOut[]
  user_permissions       UserPermission[]
  created_at             DateTime           @default(now()) @map("created_at")
  updated_at             DateTime           @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Permission {
  permission_uuid String           @id @default(uuid()) @map("permission_uuid")
  code            String           @unique
  name            String
  category        String
  description     String?
  role_mappings   RolePermission[]
  user_permissions UserPermission[]
  created_at      DateTime         @default(now()) @map("created_at")

  @@index([code])
  @@index([category])
  @@map("permissions")
}

model RoleDefinition {
  role_uuid        String           @id @default(uuid()) @map("role_uuid")
  code             String           @unique
  name             String
  description      String?
  is_system        Boolean          @default(false) @map("is_system")
  created_at       DateTime         @default(now()) @map("created_at")
  updated_at       DateTime         @updatedAt @map("updated_at")
  role_permissions RolePermission[]
  users            User[]

  @@index([code])
  @@map("roles")
}

model RolePermission {
  role_permission_uuid String         @id @default(uuid()) @map("role_permission_uuid")
  role_uuid            String         @map("role_uuid")
  role_code            String         @map("role_code")
  permission_uuid      String         @map("permission_uuid")
  role                 RoleDefinition @relation(fields: [role_uuid], references: [role_uuid], onDelete: Cascade)
  permission           Permission     @relation(fields: [permission_uuid], references: [permission_uuid], onDelete: Cascade)

  @@unique([role_uuid, permission_uuid])
  @@index([role_uuid])
  @@index([role_code])
  @@index([permission_uuid])
  @@map("role_permissions")
}

model UserPermission {
  user_permission_uuid String     @id @default(uuid()) @map("user_permission_uuid")
  user_uuid            String     @map("user_uuid")
  permission_uuid      String     @map("permission_uuid")
  is_granted           Boolean    @default(true) @map("is_granted")
  granted_by_uuid      String?    @map("granted_by_uuid")
  created_at           DateTime   @default(now()) @map("created_at")
  updated_at           DateTime   @updatedAt @map("updated_at")

  user                 User       @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  permission           Permission @relation(fields: [permission_uuid], references: [permission_uuid], onDelete: Cascade)

  @@unique([user_uuid, permission_uuid])
  @@index([user_uuid])
  @@index([permission_uuid])
  @@map("user_permissions")
}

model RefreshToken {
  token_uuid String   @id @default(uuid()) @map("token_uuid")
  token_hash String   @unique @map("token_hash")
  user_uuid  String   @map("user_uuid")
  user       User     @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  expires_at DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  user_agent String?  @map("user_agent")
  ip_address String?  @map("ip_address")
  created_at DateTime @default(now()) @map("created_at")

  @@index([user_uuid])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model MenuItem {
  menu_uuid           String     @id @default(uuid()) @map("menu_uuid")
  parent_uuid         String?    @map("parent_uuid")
  parent              MenuItem?  @relation("MenuHierarchy", fields: [parent_uuid], references: [menu_uuid], onDelete: Cascade)
  children            MenuItem[] @relation("MenuHierarchy")
  label               String
  icon                String
  route               String
  display_order       Int        @default(0) @map("display_order")
  is_active           Boolean    @default(true) @map("is_active")
  required_permission String?    @map("required_permission")
  allowed_roles       String     @default("SUPER_ADMIN,ADMIN,MODERATOR") @map("allowed_roles")
  created_at          DateTime   @default(now()) @map("created_at")
  updated_at          DateTime   @updatedAt @map("updated_at")

  @@index([parent_uuid])
  @@index([display_order])
  @@map("menu_items")
}

model AuditLog {
  audit_log_uuid         String   @id @default(uuid()) @map("audit_log_uuid")
  actor_uuid             String?  @map("actor_uuid")
  actor_email            String?  @map("actor_email")
  action                 String
  resource_type          String   @map("resource_type")
  affected_resource_uuid String?  @map("affected_resource_uuid")
  timestamp              DateTime @default(now())
  correlation_id         String   @map("correlation_id")
  outcome                String   @default("SUCCESS")
  before_state           Json?    @map("before_state")
  after_state            Json?    @map("after_state")
  ip_address             String?  @map("ip_address")
  user_agent             String?  @map("user_agent")

  @@index([actor_uuid])
  @@index([resource_type])
  @@index([timestamp])
  @@index([correlation_id])
  @@map("audit_logs")
}

model UserActivityLog {
  activity_log_uuid String   @id @default(uuid()) @map("activity_log_uuid")
  user_uuid         String?  @map("user_uuid")
  target_user       User?    @relation("TargetUser", fields: [user_uuid], references: [user_uuid], onDelete: SetNull)
  actor_uuid        String?  @map("actor_uuid")
  actor_user        User?    @relation("ActorUser", fields: [actor_uuid], references: [user_uuid], onDelete: SetNull)
  action            String
  timestamp         DateTime @default(now())
  correlation_id    String   @map("correlation_id")
  metadata          Json?    @map("metadata")
  ip_address        String?  @map("ip_address")
  user_agent        String?  @map("user_agent")

  @@index([user_uuid])
  @@index([actor_uuid])
  @@index([action])
  @@index([timestamp])
  @@map("user_activity_logs")
}

model Setting {
  setting_uuid    String   @id @default(uuid()) @map("setting_uuid")
  key             String   @unique
  value           String
  type            String   @default("STRING")
  category        String   @default("GENERAL")
  is_public       Boolean  @default(false) @map("is_public")
  description     String?
  updated_by_uuid String?  @map("updated_by_uuid")
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([category])
  @@map("settings")
}

// -----------------------------------------------------------------------------
// Messaging Platform - Providers, Configurations, Templates & Delivery
// -----------------------------------------------------------------------------

enum MessagingChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  COMING_SOON
}

enum MessageSendingStatus {
  DRAFT
  QUEUED
  PROCESSING
  SENT
  ACCEPTED
  DELIVERED
  READ
  FAILED
  BOUNCED
  CANCELLED
}

model Provider {
  provider_uuid        String                     @id @default(uuid()) @map("provider_uuid")
  name                 String
  slug                 String                     @unique
  type                 MessagingChannel           @default(EMAIL)
  description          String?
  logo                 String?
  configuration_schema Json                       @map("configuration_schema")
  form_fields          Json                       @map("form_fields")
  documentation_url    String?                    @map("documentation_url")
  status               ProviderStatus             @default(ACTIVE)
  is_default           Boolean                    @default(false) @map("is_default")
  created_at           DateTime                   @default(now()) @map("created_at")
  updated_at           DateTime                   @updatedAt @map("updated_at")
  deleted_at           DateTime?                  @map("deleted_at")
  user_configurations  UserProviderConfiguration[]
  email_messages       EmailMessage[]

  @@index([slug])
  @@index([type])
  @@index([status])
  @@map("providers")
}

model UserProviderConfiguration {
  configuration_uuid String           @id @default(uuid()) @map("configuration_uuid")
  user_uuid          String           @map("user_uuid")
  user               User             @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_uuid      String           @map("provider_uuid")
  provider           Provider         @relation(fields: [provider_uuid], references: [provider_uuid], onDelete: Restrict)
  configuration_name String           @map("configuration_name")
  type               MessagingChannel @default(EMAIL)
  credentials        String           // Encrypted JSON ciphertext with IV/tag
  sender_name        String           @map("sender_name")
  sender_email       String?          @map("sender_email")
  sender_phone       String?          @map("sender_phone")
  reply_to           String?          @map("reply_to")
  is_active          Boolean          @default(true) @map("is_active")
  is_verified        Boolean          @default(false) @map("is_verified")
  is_default         Boolean          @default(false) @map("is_default")
  last_tested_at     DateTime?        @map("last_tested_at")
  last_error         String?          @map("last_error")
  created_at         DateTime         @default(now()) @map("created_at")
  updated_at         DateTime         @updatedAt @map("updated_at")
  deleted_at         DateTime?        @map("deleted_at")
  email_messages     EmailMessage[]
  webhook_endpoints  ProviderWebhookEndpoint[]
  webhook_events     ProviderWebhookEvent[]
  message_events     MessageEvent[]
  whatsapp_conversations WhatsAppConversation[]
  whatsapp_messages      WhatsAppMessage[]
  whatsapp_templates     WhatsAppTemplate[]
  sms_conversations      SmsConversation[]
  sms_messages           SmsMessage[]

  @@index([user_uuid])
  @@index([provider_uuid])
  @@index([type])
  @@index([is_active])
  @@index([is_default])
  @@map("user_provider_configurations")
}

model EmailTemplate {
  template_uuid  String         @id @default(uuid()) @map("template_uuid")
  user_uuid      String         @map("user_uuid")
  user           User           @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  name           String
  description    String?
  subject        String
  html_content   String         @map("html_content")
  text_content   String?        @map("text_content")
  variables      Json           @default("[]")
  is_active      Boolean        @default(true) @map("is_active")
  created_at     DateTime       @default(now()) @map("created_at")
  updated_at     DateTime       @updatedAt @map("updated_at")
  deleted_at     DateTime?      @map("deleted_at")
  email_messages EmailMessage[]

  @@index([user_uuid])
  @@index([is_active])
  @@map("email_templates")
}

model EmailMessage {
  message_uuid       String                    @id @default(uuid()) @map("message_uuid")
  user_uuid          String                    @map("user_uuid")
  user               User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_uuid      String?                   @map("provider_uuid")
  provider           Provider?                 @relation(fields: [provider_uuid], references: [provider_uuid], onDelete: SetNull)
  configuration_uuid String?                   @map("configuration_uuid")
  configuration      UserProviderConfiguration? @relation(fields: [configuration_uuid], references: [configuration_uuid], onDelete: SetNull)
  template_uuid      String?                   @map("template_uuid")
  template           EmailTemplate?            @relation(fields: [template_uuid], references: [template_uuid], onDelete: SetNull)
  sender_name        String                    @map("sender_name")
  sender_email       String                    @map("sender_email")
  reply_to           String?                   @map("reply_to")
  subject            String
  html_content       String                    @map("html_content")
  text_content       String?                   @map("text_content")
  status             MessageSendingStatus      @default(QUEUED)
  provider_message_id String?                  @map("provider_message_id")
  attempts           Int                       @default(0)
  max_attempts       Int                       @default(3) @map("max_attempts")
  last_error         String?                   @map("last_error")
  sent_at            DateTime?                 @map("sent_at")
  delivered_at       DateTime?                 @map("delivered_at")
  metadata           Json?                     @default("{}")
  idempotency_key    String?                   @unique @map("idempotency_key")
  created_at         DateTime                  @default(now()) @map("created_at")
  updated_at         DateTime                  @updatedAt @map("updated_at")
  attachments        EmailAttachment[]
  recipients         MessageRecipient[]
  message_events     MessageEvent[]

  @@index([user_uuid])
  @@index([status])
  @@index([created_at])
  @@index([provider_uuid])
  @@index([configuration_uuid])
  @@map("email_messages")
}

enum RecipientType {
  TO
  CC
  BCC
}

model MessageRecipient {
  recipient_uuid String               @id @default(uuid()) @map("recipient_uuid")
  message_uuid   String               @map("message_uuid")
  message        EmailMessage         @relation(fields: [message_uuid], references: [message_uuid], onDelete: Cascade)
  email          String
  name           String?
  type           RecipientType        @default(TO)
  status         MessageSendingStatus @default(QUEUED)
  error_details  String?              @map("error_details")
  delivered_at   DateTime?            @map("delivered_at")

  @@index([message_uuid])
  @@index([email])
  @@index([type])
  @@index([status])
  @@map("message_recipients")
}

model EmailAttachment {
  attachment_uuid String       @id @default(uuid()) @map("attachment_uuid")
  message_uuid    String       @map("message_uuid")
  message         EmailMessage @relation(fields: [message_uuid], references: [message_uuid], onDelete: Cascade)
  filename        String
  content_type    String       @map("content_type")
  size_bytes      Int          @map("size_bytes")
  content_base64  String?      @map("content_base64")
  storage_url     String?      @map("storage_url")
  created_at      DateTime     @default(now()) @map("created_at")

  @@index([message_uuid])
  @@map("email_attachments")
}

enum NormalizedEventType {
  QUEUED
  PROCESSED
  ACCEPTED
  DELIVERED
  DEFERRED
  OPENED
  CLICKED
  BOUNCED
  DROPPED
  SPAM_REPORTED
  UNSUBSCRIBED
  FAILED
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
  DUPLICATE
}

model ProviderWebhookEndpoint {
  endpoint_uuid              String                    @id @default(uuid()) @map("endpoint_uuid")
  user_uuid                  String                    @map("user_uuid")
  user                       User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                   @map("provider_configuration_uuid")
  provider_configuration     UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  channel                    MessagingChannel          @default(EMAIL)
  endpoint_token_hash        String                    @unique @map("endpoint_token_hash")
  verification_secret        String?                   @map("verification_secret") // Encrypted public key / signing secret if needed
  is_active                  Boolean                   @default(true) @map("is_active")
  verification_status        Boolean                   @default(false) @map("verification_status")
  total_events_received      Int                       @default(0) @map("total_events_received")
  failed_events_count        Int                       @default(0) @map("failed_events_count")
  last_received_at           DateTime?                 @map("last_received_at")
  last_processed_at          DateTime?                 @map("last_processed_at")
  created_at                 DateTime                  @default(now()) @map("created_at")
  updated_at                 DateTime                  @updatedAt @map("updated_at")
  deleted_at                 DateTime?                 @map("deleted_at")
  webhook_events             ProviderWebhookEvent[]

  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([is_active])
  @@map("provider_webhook_endpoints")
}

model ProviderWebhookEvent {
  event_uuid                 String                    @id @default(uuid()) @map("event_uuid")
  user_uuid                  String                    @map("user_uuid")
  user                       User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                   @map("provider_configuration_uuid")
  provider_configuration     UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  webhook_endpoint_uuid      String?                   @map("webhook_endpoint_uuid")
  webhook_endpoint           ProviderWebhookEndpoint?  @relation(fields: [webhook_endpoint_uuid], references: [endpoint_uuid], onDelete: SetNull)
  provider_event_id          String?                   @map("provider_event_id")
  provider_event_type        String                    @map("provider_event_type")
  normalized_event_type      NormalizedEventType       @map("normalized_event_type")
  payload                    Json
  processing_status          WebhookProcessingStatus   @default(PENDING) @map("processing_status")
  processing_attempts        Int                       @default(0) @map("processing_attempts")
  received_at                DateTime                  @default(now()) @map("received_at")
  processed_at               DateTime?                 @map("processed_at")
  error_message              String?                   @map("error_message")
  created_at                 DateTime                  @default(now()) @map("created_at")
  updated_at                 DateTime                  @updatedAt @map("updated_at")
  message_events             MessageEvent[]

  @@unique([provider_configuration_uuid, provider_event_id])
  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([provider_event_id])
  @@index([normalized_event_type])
  @@index([processing_status])
  @@index([received_at])
  @@map("provider_webhook_events")
}

model MessageEvent {
  event_uuid                 String                    @id @default(uuid()) @map("event_uuid")
  user_uuid                  String                    @map("user_uuid")
  user                       User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  message_uuid               String                    @map("message_uuid")
  message                    EmailMessage              @relation(fields: [message_uuid], references: [message_uuid], onDelete: Cascade)
  provider_configuration_uuid String                   @map("provider_configuration_uuid")
  provider_configuration     UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  provider_event_uuid        String?                   @map("provider_event_uuid")
  provider_event             ProviderWebhookEvent?     @relation(fields: [provider_event_uuid], references: [event_uuid], onDelete: SetNull)
  event_type                 NormalizedEventType       @map("event_type")
  event_timestamp            DateTime                  @map("event_timestamp")
  recipient_email            String                    @map("recipient_email")
  clicked_url                String?                   @map("clicked_url")
  failure_reason             String?                   @map("failure_reason")
  metadata                   Json?                     @default("{}")
  created_at                 DateTime                  @default(now()) @map("created_at")

  @@index([user_uuid])
  @@index([message_uuid])
  @@index([provider_configuration_uuid])
  @@index([recipient_email])
  @@index([event_type])
  @@index([event_timestamp])
  @@map("message_events")
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  LOCATION
  INTERACTIVE
}

enum WhatsAppTemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

model WhatsAppConversation {
  conversation_uuid           String                    @id @default(uuid()) @map("conversation_uuid")
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                    @map("provider_configuration_uuid")
  provider_configuration      UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  contact_phone               String                    @map("contact_phone")
  contact_name                String?                   @map("contact_name")
  last_message_at             DateTime?                 @map("last_message_at")
  last_message_direction      WhatsAppMessageDirection? @map("last_message_direction")
  window_expires_at           DateTime?                 @map("window_expires_at")
  is_active                   Boolean                   @default(true) @map("is_active")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")
  messages                    WhatsAppMessage[]

  @@unique([provider_configuration_uuid, contact_phone])
  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([contact_phone])
  @@index([last_message_at])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  message_uuid                String                    @id @default(uuid()) @map("message_uuid")
  conversation_uuid           String                    @map("conversation_uuid")
  conversation                WhatsAppConversation      @relation(fields: [conversation_uuid], references: [conversation_uuid], onDelete: Cascade)
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                    @map("provider_configuration_uuid")
  provider_configuration      UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  direction                   WhatsAppMessageDirection  @default(OUTBOUND) @map("direction")
  message_type                WhatsAppMessageType       @default(TEXT) @map("message_type")
  provider_message_id         String?                   @unique @map("provider_message_id")
  recipient_phone             String                    @map("recipient_phone")
  sender_phone                String                    @map("sender_phone")
  content                     String?                   @map("content")
  media_url                   String?                   @map("media_url")
  template_name               String?                   @map("template_name")
  template_variables          Json?                     @default("{}") @map("template_variables")
  status                      MessageSendingStatus      @default(QUEUED) @map("status")
  error_code                  String?                   @map("error_code")
  error_message               String?                   @map("error_message")
  sent_at                     DateTime?                 @map("sent_at")
  delivered_at                DateTime?                 @map("delivered_at")
  read_at                     DateTime?                 @map("read_at")
  metadata                    Json?                     @default("{}") @map("metadata")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")

  @@index([conversation_uuid])
  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([provider_message_id])
  @@index([direction])
  @@index([status])
  @@index([created_at])
  @@map("whatsapp_messages")
}

model WhatsAppTemplate {
  template_uuid               String                    @id @default(uuid()) @map("template_uuid")
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                    @map("provider_configuration_uuid")
  provider_configuration      UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  meta_template_id            String?                   @map("meta_template_id")
  name                        String                    @map("name")
  language                    String                    @default("en_US") @map("language")
  category                    String                    @default("MARKETING") @map("category")
  status                      WhatsAppTemplateStatus    @default(APPROVED) @map("status")
  components                  Json                      @default("[]") @map("components")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")

  @@unique([provider_configuration_uuid, name, language])
  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([name])
  @@map("whatsapp_templates")
}

// -----------------------------------------------------------------------------
// SMS Messaging Models (Twilio Programmable SMS, Opt-Out Compliance, Scheduling)
// -----------------------------------------------------------------------------

enum SmsMessageDirection {
  INBOUND
  OUTBOUND
}

enum SmsEncoding {
  GSM_7BIT
  UCS2
}

model SmsConversation {
  conversation_uuid           String                    @id @default(uuid()) @map("conversation_uuid")
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                    @map("provider_configuration_uuid")
  provider_configuration      UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  contact_phone               String                    @map("contact_phone")
  contact_name                String?                   @map("contact_name")
  last_message_at             DateTime?                 @map("last_message_at")
  last_message_direction      SmsMessageDirection?      @map("last_message_direction")
  is_active                   Boolean                   @default(true) @map("is_active")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")
  messages                    SmsMessage[]

  @@unique([provider_configuration_uuid, contact_phone])
  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([contact_phone])
  @@index([last_message_at])
  @@map("sms_conversations")
}

model SmsMessage {
  message_uuid                String                    @id @default(uuid()) @map("message_uuid")
  conversation_uuid           String?                   @map("conversation_uuid")
  conversation                SmsConversation?          @relation(fields: [conversation_uuid], references: [conversation_uuid], onDelete: SetNull)
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  provider_configuration_uuid String                    @map("provider_configuration_uuid")
  provider_configuration      UserProviderConfiguration @relation(fields: [provider_configuration_uuid], references: [configuration_uuid], onDelete: Cascade)
  direction                   SmsMessageDirection       @default(OUTBOUND) @map("direction")
  provider_message_id         String?                   @unique @map("provider_message_id")
  messaging_service_sid       String?                   @map("messaging_service_sid")
  recipient_phone             String                    @map("recipient_phone")
  sender_phone                String                    @map("sender_phone")
  body                        String                    @map("body")
  segment_count               Int                       @default(1) @map("segment_count")
  encoding                    SmsEncoding               @default(GSM_7BIT) @map("encoding")
  status                      MessageSendingStatus      @default(QUEUED) @map("status")
  scheduled_at                DateTime?                 @map("scheduled_at")
  is_scheduled                Boolean                   @default(false) @map("is_scheduled")
  cancelled_at                DateTime?                 @map("cancelled_at")
  error_code                  String?                   @map("error_code")
  error_message               String?                   @map("error_message")
  price                       Float?                    @map("price")
  price_unit                  String?                   @default("USD") @map("price_unit")
  sent_at                     DateTime?                 @map("sent_at")
  delivered_at                DateTime?                 @map("delivered_at")
  failed_at                   DateTime?                 @map("failed_at")
  template_uuid               String?                   @map("template_uuid")
  template_variables          Json?                     @default("{}") @map("template_variables")
  metadata                    Json?                     @default("{}") @map("metadata")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")

  @@index([conversation_uuid])
  @@index([user_uuid])
  @@index([provider_configuration_uuid])
  @@index([provider_message_id])
  @@index([direction])
  @@index([status])
  @@index([is_scheduled])
  @@index([scheduled_at])
  @@index([created_at])
  @@map("sms_messages")
}

model SmsTemplate {
  template_uuid               String                    @id @default(uuid()) @map("template_uuid")
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  name                        String                    @map("name")
  description                 String?                   @map("description")
  body                        String                    @map("body")
  variables                   Json                      @default("[]") @map("variables")
  is_active                   Boolean                   @default(true) @map("is_active")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")
  deleted_at                  DateTime?                 @map("deleted_at")

  @@index([user_uuid])
  @@index([is_active])
  @@map("sms_templates")
}

model SmsOptOut {
  opt_out_uuid                String                    @id @default(uuid()) @map("opt_out_uuid")
  user_uuid                   String                    @map("user_uuid")
  user                        User                      @relation(fields: [user_uuid], references: [user_uuid], onDelete: Cascade)
  phone_number                String                    @map("phone_number")
  reason                      String                    @default("STOP") @map("reason")
  source                      String                    @default("INBOUND_SMS") @map("source")
  is_opted_out                Boolean                   @default(true) @map("is_opted_out")
  opted_out_at                DateTime                  @default(now()) @map("opted_out_at")
  opted_in_at                 DateTime?                 @map("opted_in_at")
  created_at                  DateTime                  @default(now()) @map("created_at")
  updated_at                  DateTime                  @updatedAt @map("updated_at")

  @@unique([user_uuid, phone_number])
  @@index([user_uuid])
  @@index([phone_number])
  @@index([is_opted_out])
  @@map("sms_opt_outs")
}



